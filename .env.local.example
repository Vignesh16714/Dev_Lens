# --- DevLens environment configuration ---
# Copy this file to `.env.local` and fill in values where required.

# Server-side only. Never prefix with NEXT_PUBLIC_. Never used in the browser.
GITHUB_TOKEN=

# Optional: OpenAI for richer AI narratives. If unset, DevLens uses its
# deterministic evidence-based insights engine (always available).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage cache TTL in minutes. 0 = always refresh with live GitHub data.
CACHE_TTL_MINUTES=120